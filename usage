#!/bin/sh
# Run the checker without having to know what Python is called here.
set -e

# Follow symlinks to find where this really lives — it gets linked onto PATH as
# claude-usage, and $0 is then the link, not the script.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *) target=$(dirname "$target")/$link ;;
    esac
done
dir=$(cd "$(dirname "$target")" && pwd)

# A .venv beside the script wins, so it never has to be activated by hand.
if [ -x "$dir/.venv/bin/python" ]; then
    exec "$dir/.venv/bin/python" "$dir/usage.py" "$@"
fi

for py in python3 python; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$dir/usage.py" "$@"
    fi
done

echo "No Python found. Install Python 3, then run this again." >&2
exit 1
